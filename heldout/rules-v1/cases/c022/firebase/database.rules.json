{
  "rules": {
    ".read": false,
    ".write": false,
    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        "memories": {
          "$memoryId": {
            ".validate": "newData.hasChildren(['text', 'createdAt'])"
          }
        }
      }
    },
    "publishedCharacters": {
      ".read": true,
      "$characterId": {
        ".write": "auth != null && (!data.exists() || data.child('creatorUid').val() === auth.uid) && newData.child('creatorUid').val() === auth.uid"
      }
    }
  }
}
