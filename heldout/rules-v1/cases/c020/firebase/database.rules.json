{
  "rules": {
    "users": {
      "$uid": {
        "profile": {
          ".read": "auth != null && auth.uid === $uid",
          ".write": "auth != null && auth.uid === $uid"
        },
        "conversations": {
          ".read": "auth != null",
          ".write": "auth != null && auth.uid === $uid"
        }
      }
    },
    "publicCharacters": {
      ".read": true,
      ".write": false
    }
  }
}
